<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Apache Kafka message transport for EricksonLopez.Messaging ecosystem.</Description>
    <PackageTags>$(CommonPackageTags);messaging;kafka;apache-kafka;streaming;event-streaming;broker;message-broker;transport</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Messaging\EricksonLopez.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Messaging.Kafka.Tests" />
  </ItemGroup>

</Project>
