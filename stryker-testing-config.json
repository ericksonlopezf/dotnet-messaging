{
  "stryker-config": {
    "project": "EricksonLopez.Messaging.Testing.csproj",
    "test-projects": [
      "EricksonLopez.Messaging.Testing.Tests.csproj"
    ],
    "mutate": [
      "**/*.cs",
      "!bin/**",
      "!obj/**",
      "!**/*.g.cs",
      "!**/*.AssemblyInfo.cs"
    ],
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "reporters": [
      "html",
      "json",
      "cleartext",
      "progress"
    ],
    "concurrency": 2
  }
}
